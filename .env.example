EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public booking website base URL (no trailing slash).
# Mobile app builds public links as: {EXPO_PUBLIC_BOOKING_SITE_URL}/book/{slug}
# Must match your deployed salo-web domain (e.g. Vercel production URL).
EXPO_PUBLIC_BOOKING_SITE_URL=https://salo-web-gamma.vercel.app

# Password reset redirect URLs — add ALL that you use in Supabase Dashboard
# → Authentication → URL Configuration → Redirect URLs:
#
# Production / native development builds:
#   salo://reset-password
#
# Expo Go local testing — force exp:// scheme (app.json "scheme": "salo" is ignored):
#   Linking.createURL('reset-password', { scheme: 'exp' })
#   Example: exp://192.168.1.191:8085/--/reset-password
#   Logged in Metro as: [SALO] resetPasswordForEmail redirectTo: ...
#   Add the exact logged URL to Supabase redirect allowlist.
